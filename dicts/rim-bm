ingen aldri mer alt gang kom kommer står sto ser veit vet gjør gjorde enn også""".split())
LYDORD = frozenset("ey yeah yeh ah aah oh ooh oohh ohh mm mmm mmmm mmmmm uh huh skrr brr shh auu haha hey yo".split())
KLISJE = ("neon", "velvet", "city lights", "fading", "broken", "shattered", "forever", "lost in your eyes",
          "you and me against the world", "rise up", "in the night we rise", "hjerter i brann",
          "drømmer i natten", "i natt vi reiser oss", "øyne fulle av drømmer",
          "byen sover aldri", "fra bunnen til toppen", "ingen stopper meg")
INSTRUMENTER = ("sax", "saxofon", "piano", "gitar", "guitar", "strings", "synth", "drums", "trommer", "beat",
                "bass", "808", "pad", "band", "orchestra", "orkester", "violin", "fiolin", "brass", "bells",
                "half-time", "drop")
# [] skal bare styre stemmen, og stemmen er full brystrøst.
STEMME_NEI = ("falsetto", "falsett", "belting", "anthemic")
PRODUKSJON = ("autotune", "auto-tune", "reverb", "delay", "fading", "distortion", "sidechain", "harmony", "harmonies")
CODE_FENCE = re.compile(r"```[^\n]*\n(.*?)```", re.S)


def _seksjon_type(navn: str) -> str:
    n = navn.strip("[]").lower()
    if re.match(r"^(?:pre[ -]?chorus|pre[ -]?refreng|førrefreng)\b", n):
        return "pre"
    if any(k in n for k in ("hook", "chorus", "refreng")):
        return "hook"
    if n.startswith(("verse", "vers")):
        return "verse"
    return "annet"


def _seksjon_kort(navn: str) -> str:
    return re.split(r"\s+-\s+|,", navn.strip("[]"))[0].strip()


def _ord(line: str) -> list[str]:
    return [t.lower() for t in TOKEN.findall(unicodedata.normalize("NFC", ADLIB.sub(" ", line)))]


def _linjer(text: str) -> list[tuple[str, str]]:
    """(seksjon, linje) for alle tekstlinjer; merker og tomme linjer hoppes over."""
    out, sec = [], ""
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("[") and line.endswith("]"):
            sec = line
            continue
        out.append((sec, line))
    return out


def _fasit_tekster(dirs: list[Path]) -> list[tuple[Path, str]]:
    out = []
    for d in dirs:
        if not d.is_dir():
            continue
        for f in sorted(d.rglob("*")):
            if f.suffix not in (".md", ".txt") or not f.is_file():
                continue
            raw = f.read_text(encoding="utf-8", errors="replace")
            blocks = CODE_FENCE.findall(raw) if f.suffix == ".md" else []
            out.append((f, "\n".join(blocks) if blocks else raw))
    return out


def _gram(ws: list[str], n: int = 4) -> list[tuple[str, ...]]:
    return [tuple(ws[i:i + n]) for i in range(len(ws) - n + 1)]


def sjekk_tekst(data: Data, text: str, fasit_dirs: list[Path], profil: str = "hoggorm") -> list[dict]:
    if profil not in ("sang", "rap", "hoggorm"):
        raise ValueError(f"Ukjent profil: {profil}")
    funn: list[dict] = []
    add = lambda kind, msg: funn.append({"type": kind, "melding": msg})
    if "..." in text or "…" in text:
        add("avkorting", "Teksten har «...» — skriv hele linjer og gjenta hooken fullt ut")
    rep = analyse_text(data, text)
    secs = rep["seksjoner"]
    lines = _linjer(text)
    core_set = {" ".join(_ord(l)) for _, l in lines}

    # Gjenbruk: fire ord eller mer på rad som står i en tidligere låt.
    grams: dict[tuple[str, ...], str] = {}
    adlib_fasit = [0, 0]
    for f, ftxt in _fasit_tekster(fasit_dirs):
        flines = [l for _, l in _linjer(ftxt)]
        same = sum(" ".join(_ord(l)) in core_set for l in flines)
        if flines and same > len(core_set) / 2:
            continue  # samme låt som den som sjekkes
        adlib_fasit[0] += sum(bool(ADLIB.search(l)) for l in flines)
        adlib_fasit[1] += len(flines)
        for l in flines:
            for g in _gram(_ord(l)):
                if not all(w in STOP for w in g):
                    grams.setdefault(g, f.name)
    meldt: set[str] = set()
    for _, l in lines:
        ws = _ord(l)
        hits = [i for i, g in enumerate(_gram(ws)) if g in grams]
        i = 0
        while i < len(hits):
            j = i
            while j + 1 < len(hits) and hits[j + 1] == hits[j] + 1:
                j += 1
            phrase = " ".join(ws[hits[i]:hits[j] + 4])
            if phrase not in meldt:
                meldt.add(phrase)
                add("gjenbruk", f"«{phrase}» står allerede i {grams[tuple(ws[hits[i]:hits[i] + 4])]}")
            i = j + 1

    # Gjentatte ord i versene (hook, bro og outro gjentar med vilje).
    count: dict[str, int] = defaultdict(int)
    for sec, l in lines:
        if _seksjon_type(sec) == "verse":
            for w in _ord(l):
                if len(w) >= 4 and w not in STOP and w not in LYDORD:
                    count[w] += 1
    for w, c in sorted(count.items(), key=lambda x: -x[1]):
        if c >= 3:
            add("gjentakelse", f"{w} ×{c} i versene")

    # Seksjonsmerker: vers skal si rap, ingen instrumenter.
    for sec in dict.fromkeys(s for s, _ in lines):
        low = sec.lower()
        if profil in ("rap", "hoggorm") and _seksjon_type(sec) == "verse" and "rap" not in low:
            add("merke", f"{sec}: versmerket sier ikke rap — Suno kan synge det")
        inst = [w for w in INSTRUMENTER if re.search(r"(?<![a-zæøå])" + re.escape(w) + r"(?![a-zæøå])", low)]
        if inst:
            add("merke", f"{sec}: instrument i merket ({', '.join(inst)}) — bare stemme i []")
        stemme = [w for w in (*STEMME_NEI, *PRODUKSJON) if re.search(r"(?<![a-zæøå])" + re.escape(w) + r"(?![a-zæøå])", low)]
        if stemme:
            add("merke", f"{sec}: {', '.join(stemme)} — [] er full brystrøst, uten falsett, belting, Anthemic eller produksjon")

    # Ad-libs i versene mot favorittene.
    vers = [l for sec, l in lines if _seksjon_type(sec) == "verse"]
    if profil == "hoggorm" and vers and adlib_fasit[1]:
        own = sum(bool(ADLIB.search(l)) for l in vers) / len(vers)
        ref = adlib_fasit[0] / adlib_fasit[1]
        if own < 0.6 * ref:
            add("ad-libs", f"{round(own * 100)} % av verslinjene har ad-libs, favorittene har {round(ref * 100)} %")

    # Hook/refreng skal være likt hver gang.
    hooks = [s for s in secs if _seksjon_type(s["navn"]) == "hook"]
    if hooks:
        first = [" ".join(_ord(l["tekst"])) for l in hooks[0]["linjer"]]
        for n, h in enumerate(hooks[1:], start=2):
            if len(h["linjer"]) != len(first):
                add("refreng", f"{_seksjon_kort(h['navn'])} nr. {n}: {len(h['linjer'])} linjer mot {len(first)} i første refreng")
            for k, l in enumerate(h["linjer"]):
                cur = " ".join(_ord(l["tekst"]))
                if k < len(first) and cur != first[k]:
                    add("refreng", f"{_seksjon_kort(h['navn'])} nr. {n}, linje {k + 1}: «{cur}» ≠ «{first[k]}»")

    # Vers mot vers: linje N bør ha omtrent like mange stavelser (rap: ±3).
    verses = [s for s in secs if _seksjon_type(s["navn"]) == "verse"]
    for v in verses[1:]:
        base = verses[0]
        for k, (a, b) in enumerate(zip(base["stavelser"], v["stavelser"]), start=1):
            if abs(a - b) > 3:
                add("vers", f"{_seksjon_kort(v['navn'])} linje {k}: {b} stavelser mot {a} i {_seksjon_kort(base['navn'])}")

    # Ekko: slutten av et vers skal ikke gjenta starten av hooken som følger.
    for a, b in zip(secs, secs[1:]):
        if _seksjon_type(a["navn"]) == "verse" and _seksjon_type(b["navn"]) == "hook":
            start = {clean(l["sluttord"]) for l in hooks[0]["linjer"][:2]}  # den kanoniske hooken
            for l in a["linjer"][-2:]:
                if clean(l["sluttord"]) in start:
                    add("ekko", f"{_seksjon_kort(a['navn'])} slutter på «{l['sluttord']}», samme som starten av hooken")

    # Klisjeer (bare i teksten, ikke i seksjonsmerkene).
    low = "\n".join(l for _, l in lines).lower()
    for k in KLISJE:
        if re.search(r"(?<![a-zæøå])" + re.escape(k) + r"(?![a-zæøå])", low):
            add("klisjé", f"«{k}» står på forbudt-lista i Låtskriver.md")

    # Uttale for Suno.
    sett: set[str] = set()
    ukjent: list[str] = []
    for _, l in lines:
        for t in TOKEN.findall(unicodedata.normalize("NFC", ADLIB.sub(" ", l))):
            if t in sett:
                continue
            sett.add(t)
            if len(t) == 1 and t.isupper() and t != "I":
                add("uttale", f"«{t}» kan bli sunget som engelsk bokstav")
            elif len(t) > 1 and t.isupper():
                add("uttale", f"«{t}» kan bli stavet bokstav for bokstav")
            elif len(t) > 1 and clean(t) not in data.wordset and clean(t) not in LYDORD and clean(t) not in ukjent:
                ukjent.append(clean(t))
    if ukjent:
        add("uttale", "ikke i ordbanken eller egne-ord (engelsk/slang?): " + ", ".join(ukjent[:15]))
    return funn


def print_sjekk(funn: list[dict]) -> None:
    print("Sjekk:")
    if not funn:
        print("  ingen funn")
    for f in funn:
        print(f"  [{f['type']}] {f['melding']}")


