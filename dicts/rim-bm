# --------------------------------------------------------------------------- lyd

VOWELS = frozenset("aeiouyæøå")
DIPHTHONGS = frozenset({"ei", "æi", "øy", "au", "ai", "ey", "oy"})
ACCENTS = str.maketrans({
    "è": "é", "ê": "é", "ó": "o", "ò": "o", "ô": "o",
    "á": "a", "à": "a", "ü": "y", "ä": "æ", "ö": "ø",
})
NOT_LETTER = re.compile(r"[^a-zæøåé']")      # ord du skriver inn
NOT_LYD = re.compile(r"[^a-zæøåé'.]")        # lydformer i uttalefila: punktum skiller kjerner

INFL = r"(?:e|er|en|et|ene|a|es|ens|ers|ets)?$"
RULES: list[tuple[str, re.Pattern[str], str]] = [
    ("skj", re.compile(r"skj"), "sj"),
    ("hj", re.compile(r"^hj"), "j"),
    ("hv", re.compile(r"^hv"), "v"),
    ("gj", re.compile(r"^gj"), "j"),
    ("ldt", re.compile(r"ldt$"), "lt"),
    ("ld", re.compile(r"ld(?=" + INFL + ")"), "ll"),
    ("ndt", re.compile(r"ndt$"), "nt"),
    ("nd", re.compile(r"nd(?=" + INFL + ")"), "nn"),
    ("rdt", re.compile(r"rdt$"), "rt"),
    ("rd", re.compile(r"rd$"), "r"),
    ("gt", re.compile(r"gt$"), "kt"),
    ("dt", re.compile(r"dt$"), "tt"),
    ("ei", re.compile(r"ei"), "æi"),
    ("o", re.compile(r"o(?=pp|tt|kk|ss|ll|nn|ff|bb|gg|dd)"), "å"),
]

WEAK_E_FINAL = frozenset({"", "n", "r", "t", "s", "l", "st"})
WEAK_E_INNER = frozenset({"n", "r", "t", "l", "st", "ls", "rn", "nd"})
WEAK_I = frozenset({"ng", "ngs", "g", "gs", "gst", "sk", "skt"})
HET = re.compile(r"h(?:et|eten|eter|etene|ets)$")
HIATUS_SUFFIX = ("", "n", "r", "s", "ne", "en", "er", "et", "ns", "rs", "ene")
NATIVE_PREFIX = re.compile(r"^(be|for|av|gjen|om|over|under)")
PREFIX = re.compile(r"^(be|ge|for)(?=[^aeiouyæøå])")
ERE = re.compile(
    r"^(?P<stem>.*[^aeiouyæøå])(?P<suf>ere|erer|eres|erte|ertes|ert|ering|eringa|eringen|eringer|eringene|erende)$"
)
STRESSED_END = [re.compile(r"it(?P<v>e)t(?:en|er|ene|s)?$")]


def nuclei(s: str) -> list[tuple[int, int]]:
    """Vokalkjerner som (start, slutt). Diftonger og strekte vokaler er én kjerne."""
    out: list[tuple[int, int]] = []
    i, n = 0, len(s)
    while i < n:
        if s[i] not in VOWELS:
            i += 1
            continue
        j = i + 1
        if j < n and s[i:j + 1] in DIPHTHONGS:
            j += 1
        elif s[i] != "e":
            while j < n and s[j] == s[i]:
                j += 1
        out.append((i, j))
        i = j
    return out


def clean(word: str) -> str:
    w = unicodedata.normalize("NFC", word).lower().translate(ACCENTS)
    return NOT_LETTER.sub("", w)


def clean_lyd(value: str) -> str:
    w = unicodedata.normalize("NFC", value).lower().translate(ACCENTS)
    return NOT_LYD.sub("", w)


def load_uttale(path: Path) -> dict[str, str]:
    exc: dict[str, str] = {}
    if not path.is_file():
        return exc
    for line in path.read_text(encoding="utf-8").splitlines():
        line = line.split("#", 1)[0].strip()
        if not line:
            continue
        parts = line.split(maxsplit=1)
        if len(parts) >= 2:
            exc[clean(parts[0]).replace("'", "")] = "|".join(clean_lyd(v.strip()) for v in parts[1].split("|") if v.strip())
    return exc


def lydform(word: str, exc: dict[str, str], skrift: bool = False) -> str:
    """Lydform med ' foran trykkvokalen når trykket er kjent."""
    w = clean(word)
    plain = w.replace("'", "")
    if not skrift and plain in exc:
        return exc[plain].split("|")[0]
    if "é" in w:
        k = w.rfind("é")
        w = w[:k] + "'e" + w[k + 1:]
        w = w.replace("é", "e")
    if skrift:
        return w
    skip_nd = w.endswith(("ende", "endes")) and len(nuclei(w)) >= 3
    for name, rx, rep in RULES:
        if skip_nd and name == "nd":
            continue
        w = rx.sub(rep, w)
    return w


def _hiatus_word(w: str, wordset) -> bool:
    """Ord som familie, studio og video, med eller uten bøyningsendelse."""
    for suf in HIATUS_SUFFIX:
        if suf and not w.endswith(suf):
            continue
        base = w[: -len(suf)] if suf else w
        if base.endswith(("ie", "io", "eo")) and (not suf or base in wordset):
            return True
    return False


def _is_weak(lf: str, nuc: list[tuple[int, int]], i: int, genitive: bool,
             het: int = -1, hiatus: bool = False) -> bool:
    s, e = nuc[i]
    v = lf[s:e]
    final = i == len(nuc) - 1
    coda = lf[e:] if final else lf[e:nuc[i + 1][0]]
    if final and genitive and coda.endswith("s"):
        coda = coda[:-1]
    # -het: h-en hører til suffikset, ikke til stavelsen foran (mulighet, sikkerhet).
    if not final and het >= 0 and nuc[i + 1][0] - 1 == het and coda.endswith("h"):
        coda = coda[:-1]
    # Hiatus i familie, studio, video: i/e rett foran trykklett e/o, og o etter i/e.
    if hiatus and coda == "":
        if v in ("i", "e") and not final and lf[nuc[i + 1][0]:nuc[i + 1][1]] in ("e", "o"):
            return True
        if v == "o" and s > 0 and lf[s - 1] in "ie":
            return True
    if v == "e":
        return coda in (WEAK_E_FINAL if final else WEAK_E_INNER)
    if v == "a":
        return final and coda in ("", "s")
    if v == "i":
        return coda in WEAK_I
    if v == "y":
        return final and coda == "" and not NATIVE_PREFIX.match(lf)
    if v == "o" and s > 0 and lf[s - 1] in "ds" and coda in ("m", "mt", "mm", "ms"):
        return True
    return False


def stress(lf_marked: str, word: str, wordset: frozenset[str] | set[str]) -> tuple[str, list[tuple[int, int]], int]:
    """Returnerer (lydform uten merke, kjerner, indeks for trykkstavelsen)."""
    if "'" in lf_marked:
        k = lf_marked.index("'")
        lf = lf_marked.replace("'", "")
        nuc = nuclei(lf)
        for idx, (s, _) in enumerate(nuc):
            if s >= k:
                return lf, nuc, idx
        return lf, nuc, max(len(nuc) - 1, 0)

    lf = lf_marked
    nuc = nuclei(lf)
    n = len(nuc)
    if n <= 1:
        return lf, nuc, 0

    for rx in STRESSED_END:
        m = rx.search(lf)
        if m:
            for idx, (s, _) in enumerate(nuc):
                if s == m.start("v"):
                    return lf, nuc, idx

    w = clean(word).replace("'", "")
    m = ERE.match(w)
    if m and any(c in VOWELS for c in m.group("stem")) and (m.group("stem") + "ert") in wordset \
            and lf.endswith(m.group("suf")):
        pos = len(lf) - len(m.group("suf"))
        for idx, (s, _) in enumerate(nuc):
            if s == pos:
                return lf, nuc, idx

    genitive = w.endswith("s") and not w.endswith("ss") and len(w) > 3 and w[:-1] in wordset
    hm = HET.search(lf)
    het = hm.start() if hm and hm.start() > 0 else -1
    hiatus = _hiatus_word(w, wordset)
    i = n - 1
    while i > 0 and _is_weak(lf, nuc, i, genitive, het, hiatus):
        i -= 1

    if i == 0:
        pm = PREFIX.match(lf)
        if pm:
            p = len(pm.group(1))
            doubled = lf[p] == lf[p - 1] or (p + 1 < len(lf) and lf[p] == lf[p + 1])
            if not doubled and len(nuclei(lf[p:])) >= 2:
                i = 1
    return lf, nuc, i


@dataclass
class Info:
    ord: str
    lyd: str
    nokkel: str
    stav: int
    trykk: int  # 1-basert stavelse med trykk
    metode: str = "heuristikk"
    usikker: bool = True  # tekstbasert analyse, ikke verifisert lyd


def analyse(word: str, exc: dict[str, str], wordset, skrift: bool = False, variant: str | None = None) -> Info:
    marked = variant if variant is not None else lydform(word, exc, skrift)
    metode = "skrift" if skrift else ("uttalefil" if clean(word) in exc else "heuristikk")
    lf, nuc, i = stress(marked, word, wordset)
    if not nuc:
        return Info(word, lf.replace(".", ""), lf.replace(".", ""), 1 if lf else 0, 1, metode)
    return Info(word, lf.replace(".", ""), lf[nuc[i][0]:].replace(".", ""), len(nuc), i + 1, metode)


def skjevt_key(key: str) -> str:
    """Trykkvokal + konsonanttype: N nasal, P plosiv, F frikativ, L for l, R for r."""
    s = key.replace("ng", "ŋ").replace("nk", "ŋk")
    s = re.sub(r"skj|sj|kj|tj|rs", "ʃ", s)
    out: list[str] = []
    for ch in s:
        if ch in VOWELS:
            c = ch
        elif ch in "mnŋ":
            c = "N"
        elif ch in "ptkbdgcqx":
            c = "P"
        elif ch in "fvshʃjwz":
            c = "F"
        elif ch == "l":
            c = "L"
        elif ch == "r":
            c = "R"
        else:
            c = "?"
        if out and out[-1] == c and c.isupper():
            continue
        out.append(c)
    return "".join(out)


# Vokaler som ligger nær nok til å klinge sammen i rap.
NEAR_VOWELS = frozenset(frozenset(p) for p in ("eæ", "oå", "ou", "yi", "øy"))
ASSONANS_MIN = 0.65


@lru_cache(maxsize=None)
def _vokaler(key: str) -> tuple[str, ...]:
    out = []
    for s, e in nuclei(key):
        v = key[s:e]
        out.append(v if v in DIPHTHONGS else v[0])
    return tuple(out)


@lru_cache(maxsize=None)
def _konsonanter(key: str) -> str:
    return "".join(c for c in skjevt_key(key) if c.isupper())


def _vokal_score(a: str, b: str) -> float:
    if a == b:
        return 1.0
    return 0.5 if frozenset((a, b)) in NEAR_VOWELS else 0.0


@lru_cache(maxsize=None)
def assonans(ka: str, kb: str) -> float:
    """Vokalklang fra trykkvokalen og ut, 0–1. Trykkvokalen teller dobbelt; konsonanttype 40 %."""
    va, vb = _vokaler(ka), _vokaler(kb)
    if not va or not vb or _vokal_score(va[0], vb[0]) == 0:
        return 0.0
    total = denom = 0.0
    for i in range(max(len(va), len(vb))):
        w = 2.0 if i == 0 else 1.0
        denom += w
        if i < len(va) and i < len(vb):
            total += w * _vokal_score(va[i], vb[i])
    ca, cb = _konsonanter(ka), _konsonanter(kb)
    cons = difflib.SequenceMatcher(None, ca, cb).ratio() if (ca or cb) else 1.0
    return round(0.6 * total / denom + 0.4 * cons, 2)


def assonans_grad(score: float) -> str | None:
    if score >= 0.85:
        return "sterk"
    if score >= ASSONANS_MIN:
        return "middels"
    if score >= 0.5:
        return "svak"
    return None


def load_egne(path: Path) -> tuple[set[str], dict[str, str]]:
    """egne-ord.txt: ett ord per linje, eventuelt fulgt av lydform som i uttale.txt."""
    words: set[str] = set()
    exc: dict[str, str] = {}
    if not path.is_file():
        return words, exc
    for line in path.read_text(encoding="utf-8").splitlines():
        line = line.split("#", 1)[0].strip()
        if not line:
            continue
        parts = line.split(maxsplit=1)
        w = clean(parts[0]).replace("'", "")
        if not w:
            continue
        words.add(w)
        if len(parts) == 2:
            exc[w] = "|".join(clean_lyd(v.strip()) for v in parts[1].split("|") if v.strip())
    return words, exc


# --------------------------------------------------------------------------- data

CACHE_KEEP = 3
TMP_MAX_AGE = 3600


def prune_cache(cache_dir: Path, mode: str, keep: int = CACHE_KEEP) -> None:
    """Behold de sist brukte indeksene per modus. Gamle oppstår hver gang uttale.txt endres."""
    import time
    try:
        files = sorted(cache_dir.glob(f"indeks-{mode}-*.pkl"), key=lambda p: p.stat().st_mtime, reverse=True)
        for old in files[keep:]:
            old.unlink(missing_ok=True)
        cutoff = time.time() - TMP_MAX_AGE
        for tmp in cache_dir.glob("indeks-*.tmp"):
            if tmp.stat().st_mtime < cutoff:
                tmp.unlink(missing_ok=True)
    except OSError:
        pass


class Data:
    def __init__(self, wordlist: Path, uttale: Path, frekvens: Path, skrift: bool, use_cache: bool = True,
                 egne: Path | None = None):
        if not wordlist.is_file():
            raise FileNotFoundError(str(wordlist))
        self.wordlist, self.uttale_path, self.skrift = wordlist, uttale, skrift
        self.egne_path = egne if egne is not None else EGNE
        self.egne, egne_exc = load_egne(self.egne_path)
        self.exc = {} if skrift else {**load_uttale(STANDARD), **egne_exc, **load_uttale(uttale)}
        self.freq = self._load_freq(frekvens)
        for w in self.egne:
            self.freq[w] = -1  # egne ord først, og de teller som vanlige
        self.index, self.wordset = self._load_index(use_cache)
        self._skjevt: dict[str, list[str]] | None = None

    @staticmethod
    def _load_freq(path: Path) -> dict[str, int]:
        freq: dict[str, int] = {}
        if path.is_file():
            for rank, line in enumerate(path.read_text(encoding="utf-8").splitlines()):
                w = line.split(" ", 1)[0].strip().lower()
                if w and w not in freq:
                    freq[w] = rank
        return freq

    def _signature(self) -> str:
        parts = [VERSION, "skrift" if self.skrift else "uttale", str(self.wordlist)]
        for p in (self.wordlist, STANDARD, self.uttale_path, self.egne_path):
            st = p.stat() if p.is_file() else None
            parts.append(f"{p}:{st.st_mtime_ns}:{st.st_size}" if st else f"{p}:-")
        return hashlib.sha1("|".join(parts).encode()).hexdigest()[:16]

    def _load_index(self, use_cache: bool):
        mode = "skrift" if self.skrift else "uttale"
        cache = CACHE_DIR / f"indeks-{mode}-{self._signature()}.pkl"
        if use_cache and cache.is_file():
            try:
                with cache.open("rb") as f:
                    result = pickle.load(f)
                try:
                    os.utime(cache)  # merk som nylig brukt, så den ikke ryddes bort
                except OSError:
                    pass
                return result
            except Exception:
                pass
        words = sorted({unicodedata.normalize("NFC", ln.strip()).lower() for ln in self.wordlist.read_text(encoding="utf-8").splitlines() if ln.strip()} | self.egne)
        wordset = frozenset(words)
        index: dict[str, list[tuple[str, int]]] = defaultdict(list)
        for w in words:
            variants = self.exc.get(w, "").split("|") if w in self.exc else [None]
            entries = set()
            for variant in variants:
                info = analyse(w, self.exc, wordset, self.skrift, variant)
                entries.add((info.nokkel, info.stav))
            for key, count in sorted(entries):
                index[key].append((w, count))
        result = (dict(index), wordset)
        if use_cache:
            try:
                CACHE_DIR.mkdir(parents=True, exist_ok=True)
                fd, name = tempfile.mkstemp(prefix=cache.stem + "-", suffix=".tmp", dir=CACHE_DIR)
                os.close(fd)
                tmp = Path(name)
                with tmp.open("wb") as f:
                    pickle.dump(result, f, protocol=pickle.HIGHEST_PROTOCOL)
                tmp.replace(cache)
                prune_cache(CACHE_DIR, mode)
            except OSError:
                pass
        return result

    def info(self, word: str, skrift: bool | None = None) -> Info:
        return analyse(word, {} if (skrift if skrift is not None else self.skrift) else self.exc,
                       self.wordset, self.skrift if skrift is None else skrift)

    def infos(self, word: str) -> list[Info]:
        variants = self.exc.get(clean(word), "").split("|") if clean(word) in self.exc else [None]
        return [analyse(word, self.exc, self.wordset, self.skrift, v) for v in variants]

    def skjevt_keys(self, key: str) -> list[str]:
        if self._skjevt is None:
            m: dict[str, list[str]] = defaultdict(list)
            for k in self.index:
                m[skjevt_key(k)].append(k)
            self._skjevt = m
        return self._skjevt.get(skjevt_key(key), [])

    def is_self_compound(self, w: str, q: str) -> bool:
        if len(q) < 3 or w == q or not w.endswith(q):
            return False
        pre = w[: -len(q)]
        return pre in self.wordset or (len(pre) > 2 and pre[-1] in "se" and pre[:-1] in self.wordset)

    def rhymes(self, query: str, *, stav=None, limit=40, skjevt=False, filt=True, vanlige=False, assonans=False):
        qi = self.info(query)
        q = clean(query).replace("'", "")
        own_keys = {v.nokkel for v in self.infos(query)}
        score: dict[str, float] = {}
        if assonans:
            for k in self.index:
                if k not in own_keys:
                    best = max(globals()["assonans"](o, k) for o in own_keys)
                    if best >= ASSONANS_MIN:
                        score[k] = best
            keys = sorted(score)
        elif skjevt:
            keys = sorted({k for key in own_keys for k in self.skjevt_keys(key)})
        else:
            keys = sorted(own_keys)
        word_score: dict[str, float] = {}
        seen: set[str] = set()
        groups: dict[int, list[str]] = defaultdict(list)
        for k in keys:
            for w, s in self.index.get(k, []):
                if w == q or w in seen:
                    continue
                if skjevt and k in own_keys:
                    continue
                if filt and self.is_self_compound(w, q):
                    continue
                if vanlige and w not in self.freq:
                    continue
                if stav is not None and s != stav:
                    continue
                seen.add(w)
                groups[s].append(w)
                word_score[w] = score.get(k, 1.0)
        inf = len(self.freq) + 1
        out = {}
        for s in sorted(groups):
            ws = sorted(groups[s], key=lambda x: (-word_score[x], self.freq.get(x, inf), len(x), x))
            out[s] = ws[:limit]
        return qi, out


