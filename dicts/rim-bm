def check_pair(data: Data, a: str, b: str) -> dict:
    va, vb = data.infos(a), data.infos(b)
    combos = [(x, y) for x in va for y in vb]
    exact = [(x, y) for x, y in combos if x.nokkel == y.nokkel]
    near = [(x, y) for x, y in combos if skjevt_key(x.nokkel) == skjevt_key(y.nokkel)]
    ia, ib = (exact or near or combos)[0]
    best = max(assonans(x.nokkel, y.nokkel) for x, y in combos)
    sa, sb = data.info(a, skrift=True), data.info(b, skrift=True)
    same = clean(a) == clean(b)
    return {
        "a": a, "b": b,
        "varianter": [[asdict(v) for v in va], [asdict(v) for v in vb]],
        "metode": [ia.metode, ib.metode],
        "usikker": True,
        "samme_ord": same,
        "treff": (ia.nokkel == ib.nokkel) and not same,
        "multi": (ia.nokkel == ib.nokkel) and not same and len(nuclei(ia.nokkel)) >= 2,
        "skjevt": (ia.nokkel != ib.nokkel) and skjevt_key(ia.nokkel) == skjevt_key(ib.nokkel),
        "nokkel": [ia.nokkel, ib.nokkel],
        "lyd": [ia.lyd, ib.lyd],
        "assonans": best,
        "assonans_grad": assonans_grad(best),
        "skrift_treff": sa.nokkel == sb.nokkel,
        "skrift_nokkel": [sa.nokkel, sb.nokkel],
    }


def format_pair(r: dict) -> str:
    a, b = r["a"], r["b"]
    if r["samme_ord"]:
        return f"{a} / {b} — samme ord, teller ikke som rimpar"
    res = "rim-bm treff" if r["treff"] else ("ikke treff (skjevt: samme vokal og konsonanttype)" if r["skjevt"] else "ikke treff")
    if r["treff"] and r.get("multi"):
        res += " · multi"
    if not r["treff"] and r.get("assonans_grad"):
        res += f" · assonans {round(r['assonans'] * 100)} % ({r['assonans_grad']})"
    line = f"{a} / {b} — oppslag: {res} — nøkkel «{r['nokkel'][0]}» / «{r['nokkel'][1]}»"
    if r["lyd"] != [clean(a), clean(b)]:
        line += f" (lyd «{r['lyd'][0]}» / «{r['lyd'][1]}»)"
    if any(len(v) > 1 for v in r["varianter"]):
        line += " · variantavhengig; sjekk planlagt uttale"
    if r["skrift_treff"] != r["treff"]:
        line += f" · på skrift: {'treff' if r['skrift_treff'] else 'ikke treff'}"
    return line


# --------------------------------------------------------------------------- --tekst

TOKEN = re.compile(r"[A-Za-zÆØÅæøåÉéÈèÊêÓóÒòÔôÜüÄäÖö']+")
ADLIB = re.compile(r"\([^)]*\)")
DIGIT = re.compile(r"\d")


def line_syllables(data: Data, tokens: list[str]) -> int:
    total = 0
    for t in tokens:
        info = data.info(t)
        total += max(info.stav, 1)
    return total


def _innhold(token: str) -> bool:
    t = token.lower()
    return len(t) >= 3 and t not in STOP and t not in LYDORD


def _innrim(data: Data, tokens: list[str]) -> list[str]:
    """Innholdsord tidligere i linja som har samme rimnøkkel som sluttordet."""
    if len(tokens) < 2:
        return []
    end = tokens[-1]
    key = data.info(end).nokkel
    if not key:
        return []
    hit = []
    for t in tokens[:-1]:
        if not _innhold(t) or clean(t) == clean(end):
            continue
        if data.info(t).nokkel == key and t not in hit:
            hit.append(t)
    return hit


def analyse_text(data: Data, text: str) -> dict:
    sections: list[dict] = []
    cur = {"navn": "", "linjer": []}
    warnings: list[str] = []
    for raw in text.splitlines():
        line = raw.strip()
        if not line:
            continue
        if line.startswith("[") and line.endswith("]"):
            if cur["linjer"]:
                sections.append(cur)
            cur = {"navn": line, "linjer": []}
            continue
        core = ADLIB.sub(" ", line)
        if DIGIT.search(core):
            warnings.append(f"Tall i linja «{line}» — skriv tallet med bokstaver.")
        tokens = TOKEN.findall(unicodedata.normalize("NFC", core))
        if not tokens:
            continue
        for token in tokens:
            if len(data.infos(token)) > 1:
                note = f"Flere uttaler for «{token}»: --tekst bruker første variant; kontroller manuelt."
                if note not in warnings:
                    warnings.append(note)
        end = tokens[-1]
        info = data.info(end)
        cur["linjer"].append({
            "tekst": line, "stav": line_syllables(data, tokens),
            "sluttord": end, "nokkel": info.nokkel,
            "ord": tokens, "innrim": _innrim(data, tokens),
        })
    if cur["linjer"]:
        sections.append(cur)

    pairs: dict[tuple[str, str], dict] = {}
    assonans_par: list[dict] = []
    for sec in sections:
        seen: list[dict] = []
        next_letter = 0
        for ln in sec["linjer"]:
            partner, kind = None, None
            for prev in reversed(seen):
                if prev["nokkel"] == ln["nokkel"]:
                    partner, kind = prev, "treff"
                    break
            if partner is None:
                for prev in reversed(seen):
                    if skjevt_key(prev["nokkel"]) == skjevt_key(ln["nokkel"]):
                        partner, kind = prev, "skjevt"
                        break
            if partner is not None:
                ln["bokstav"] = partner["bokstav"]
                same = clean(partner["sluttord"]) == clean(ln["sluttord"])
                ln["rimer_med"] = partner["sluttord"]
                ln["type"] = "samme ord" if same else kind
                if kind == "treff" and not same and len(nuclei(ln["nokkel"])) >= 2:
                    ln["multi"] = True
                pa, pb = ln.get("ord", []), partner.get("ord", [])
                if kind == "treff" and not same and len(pa) >= 2 and len(pb) >= 2:
                    wa, wb = pa[-2], pb[-2]
                    if _innhold(wa) and _innhold(wb) and clean(wa) != clean(wb) and data.info(wa).nokkel == data.info(wb).nokkel:
                        ln["flerord"] = f"{wa} {pa[-1]} / {wb} {pb[-1]}"
                if not same:
                    k = tuple(sorted((clean(partner["sluttord"]), clean(ln["sluttord"]))))
                    if k not in pairs:
                        pairs[k] = check_pair(data, partner["sluttord"].lower(), ln["sluttord"].lower())
            else:
                ln["bokstav"] = chr(ord("A") + next_letter % 26)
                next_letter += 1
                ln["rimer_med"], ln["type"] = None, None
                # Assonans er en merknad: den endrer ikke rimskjemaet. Bare de to forrige linjene.
                cands = [(assonans(prev["nokkel"], ln["nokkel"]), prev) for prev in seen[-2:]
                         if clean(prev["sluttord"]) != clean(ln["sluttord"])]
                cands = [c for c in cands if c[0] >= ASSONANS_MIN]
                if cands:
                    sc, prev = max(cands, key=lambda c: c[0])
                    ln["rimer_med"], ln["type"], ln["assonans"] = prev["sluttord"], "assonans", sc
                    assonans_par.append({"a": prev["sluttord"], "b": ln["sluttord"], "assonans": sc,
                                         "grad": assonans_grad(sc)})
            seen.append(ln)
        sec["skjema"] = "".join(l["bokstav"] for l in sec["linjer"])
        sec["stavelser"] = [l["stav"] for l in sec["linjer"]]
    return {"seksjoner": sections, "rimpar": list(pairs.values()), "assonanspar": assonans_par,
            "advarsler": warnings}


def print_text_report(rep: dict) -> None:
    width = max([len(l["tekst"]) for s in rep["seksjoner"] for l in s["linjer"]] + [20])
    width = min(width, 60)
    for sec in rep["seksjoner"]:
        if sec["navn"]:
            print(sec["navn"])
        for l in sec["linjer"]:
            note = ""
            if l["type"] == "treff":
                note = f"treff: {l['rimer_med']}"
                if l.get("multi"):
                    note += " · multi"
                if l.get("flerord"):
                    note += f" · flerord: {l['flerord']}"
            elif l["type"] == "skjevt":
                note = f"skjevt: {l['rimer_med']}"
            elif l["type"] == "assonans":
                note = f"assonans: {l['rimer_med']} ({round(l['assonans'] * 100)} %)"
            elif l["type"] == "samme ord":
                note = "samme ord"
            if l.get("innrim"):
                inn = "innrim: " + ", ".join(l["innrim"])
                note = f"{note} · {inn}" if note else inn
            txt = l["tekst"] if len(l["tekst"]) <= width else l["tekst"][: width - 1] + "…"
            print(f"{l['stav']:>3}  {txt:<{width}}  {l['bokstav']}  «{l['nokkel']}»  {note}".rstrip())
        print(f"     Skjema: {sec['skjema']} · Stavelser: {' '.join(map(str, sec['stavelser']))}")
        print()
    if rep["rimpar"]:
        print("Rimpar (til rimloggen):")
        for r in rep["rimpar"]:
            print("  " + format_pair(r))
    if rep.get("assonanspar"):
        print("Assonans (vokalklang, ikke rent rim):")
        for a in rep["assonanspar"]:
            print(f"  {a['a']} / {a['b']} — {round(a['assonans'] * 100)} % ({a['grad']})")
    for w in rep["advarsler"]:
        print("Advarsel: " + w)


