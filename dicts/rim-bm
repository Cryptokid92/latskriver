def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(
        prog="rim-bm", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("ord", nargs="*", help="Ordet du vil rime på (eller ordene til --par / --info)")
    modes = p.add_mutually_exclusive_group()
    modes.add_argument("--batch", action="store_true", help="Søk på hvert ord med én innlasting")
    modes.add_argument("--par", action="store_true", help="Sjekk første ord mot hvert av de neste")
    modes.add_argument("--tekst", type=Path, metavar="FIL", help="Analyser en hel tekst")
    modes.add_argument("--info", action="store_true", help="Vis lydform, trykk, nøkkel og stavelser")
    p.add_argument("--stav", type=int, default=None, help="Bare denne stavelsesgruppa")
    p.add_argument("-n", "--limit", type=int, default=40, help="Maks per stavelsesgruppe (standard 40)")
    p.add_argument("--skjevt", action="store_true", help="Skjeve rim i stedet for rene")
    p.add_argument("--assonans", action="store_true", help="Vokalklang (rap): samme vokaler fra trykket, sortert etter score")
    p.add_argument("--vanlige", action="store_true", help="Bare ord som finnes i frekvenslista")
    p.add_argument("--alle", action="store_true", help="Ikke fjern sammensetninger med søkeordet")
    p.add_argument("--skrift", action="store_true", help="Sammenlign stavemåte, ikke uttale (v1-oppførsel)")
    p.add_argument("--json", action="store_true", help="Skriv resultatet som JSON")
    p.add_argument("--wordlist", type=Path, default=WORDLIST, help=f"Ordliste (standard: {WORDLIST})")
    p.add_argument("--uttale", type=Path, default=UTTALE, help=f"Unntaksfil (standard: {UTTALE})")
    p.add_argument("--frekvens", type=Path, default=FREKVENS, help=f"Frekvensliste (standard: {FREKVENS})")
    p.add_argument("--egne", type=Path, default=EGNE, help=f"Egne ord, slang og steder (standard: {EGNE})")
    p.add_argument("--profil", choices=("sang", "rap", "hoggorm"), default="hoggorm",
                   help="Regler for --sjekk (standard: hoggorm; sang krever ikke rapmerker)")
    p.add_argument("--sjekk", action="store_true", help="Med --tekst: låtsjekk (gjenbruk, gjentakelser, merker, hook, uttale)")
    p.add_argument("--fasit", type=Path, action="append", help="Mappe med tidligere låter for --sjekk (kan gjentas)")
    p.add_argument("--ingen-cache", action="store_true", help="Bygg indeksen uten å lese eller skrive cache")
    p.add_argument("--min-key", type=int, default=0, help=argparse.SUPPRESS)
    p.add_argument("--versjon", action="version", version=f"rim-bm {VERSION}")
    args = p.parse_args(argv)

    if args.limit <= 0 or (args.stav is not None and args.stav <= 0):
        p.error("--limit og --stav må være positive heltall")
    if args.assonans and args.skjevt:
        p.error("--assonans og --skjevt kan ikke brukes sammen")
    if not args.tekst and not args.ord:
        p.print_help()
        return 2

    try:
        data = Data(args.wordlist, args.uttale, args.frekvens, args.skrift, not args.ingen_cache, egne=args.egne)
    except FileNotFoundError as e:
        print(f"Finner ikke ordlista: {e}", file=sys.stderr)
        print("Kjør install.sh, eller sett RIM_BM_WORDLIST til stien for former-utf8.txt.", file=sys.stderr)
        return 1

    if args.sjekk and not args.tekst:
        p.error("--sjekk krever --tekst FIL")
    if args.tekst:
        text = args.tekst.read_text(encoding="utf-8")
        rep = analyse_text(data, text)
        if args.sjekk:
            rep["sjekk"] = sjekk_tekst(data, text, args.fasit if args.fasit is not None else (FASIT if args.profil == "hoggorm" else []), args.profil)
        if args.json:
            print(json.dumps(rep, ensure_ascii=False, indent=2))
        else:
            print_text_report(rep)
            if args.sjekk:
                print()
                print_sjekk(rep["sjekk"])
        return 0

    if args.info:
        infos = [dict(asdict(data.info(w)), varianter=[asdict(v) for v in data.infos(w)]) for w in args.ord]
        if args.json:
            print(json.dumps(infos, ensure_ascii=False, indent=2))
        else:
            for i in infos:
                for v in i["varianter"]:
                    print(f"{v['ord']}: lyd «{v['lyd']}» · nøkkel «{v['nokkel']}» · {v['stav']} stav. · trykk på stavelse {v['trykk']} · {v['metode']} (anslag)")
        return 0

    if args.par:
        if len(args.ord) < 2:
            print("--par trenger minst to ord.", file=sys.stderr)
            return 2
        res = [check_pair(data, args.ord[0], b) for b in args.ord[1:]]
        if args.json:
            print(json.dumps(res, ensure_ascii=False, indent=2))
        else:
            for r in res:
                print(format_pair(r))
        return 0

    if args.batch or len(args.ord) > 1:
        results = []
        for word in args.ord:
            qi, groups = data.rhymes(word, stav=args.stav, limit=args.limit,
                                    skjevt=args.skjevt, filt=not args.alle, vanlige=args.vanlige,
                                    assonans=args.assonans)
            results.append({"ord": asdict(qi), "varianter": [asdict(v) for v in data.infos(word)],
                            "skjevt": args.skjevt, "grupper": {str(k): v for k, v in groups.items()}})
        if args.json:
            print(json.dumps(results, ensure_ascii=False, indent=2))
        else:
            for result in results:
                print(result["ord"]["ord"] + " — tekstbaserte rimkandidater")
                print_groups({int(k): v for k, v in result["grupper"].items()})
        return 0

    word = args.ord[0]
    qi, groups = data.rhymes(word, stav=args.stav, limit=args.limit, skjevt=args.skjevt,
                             filt=not args.alle, vanlige=args.vanlige, assonans=args.assonans)
    if args.json:
        print(json.dumps({"ord": asdict(qi), "varianter": [asdict(v) for v in data.infos(word)], "skjevt": args.skjevt,
                          "grupper": {str(k): v for k, v in groups.items()}}, ensure_ascii=False, indent=2))
        return 0
    mode = "skrift" if args.skrift else "uttale"
    lyd = f"lyd «{qi.lyd}»  →  " if qi.lyd != clean(word) else ""
    kind = "assonans" if args.assonans else ("skjeve rim" if args.skjevt else mode)
    print(f"{word}  →  {lyd}nøkkel «{qi.nokkel}»  ({qi.stav} stav.)  [{len(data.wordset)} former · {kind}]")
    print()
    if not groups:
        print("Ingen treff." + ("" if args.skjevt else " Prøv --skjevt for skjeve rim."))
        return 0
    print_groups(groups)
    return 0


if __name__ == "__main__":
